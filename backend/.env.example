# Template environment DapurPangan - salin ke .env lalu isi sesuai kebutuhan
# cp backend/.env.example backend/.env

# ===== Database =====
# Default backend = SQLite lokal (file daparpangan.db dibuat otomatis di
# folder backend). Baris DATABASE_URL di bawah OPSIONAL - hanya perlu diisi
# kalau mau pindah ke PostgreSQL (docker-compose sudah menyetelnya sendiri).
# Contoh SQLite (lokal tanpa Docker, file dibuat otomatis di folder backend):
#   DATABASE_URL=sqlite:///./daparpangan.db
# Contoh PostgreSQL (pakai docker-compose / server Postgres sendiri):
#   DATABASE_URL=postgresql://daparpangan:zephyrus123@localhost:5432/daparpangan
DATABASE_URL=sqlite:///./daparpangan.db

# ===== CORS =====
# Daftar origin yang boleh akses API, format JSON array. Default ["*"]
# (terbuka - sesuai scope lomba tanpa auth).
CORS_ORIGINS=["*"]

# ===== LLM (chat AI) =====
# API key OpenCodeZen (OpenAI-compatible). Kosongkan -> chat tetap jalan
# dengan jawaban fallback dari data live database (kurang "cerdas").
OPencodeZen_API_KEY=sk-ISIKEYKAMU

# Base URL API OpenCodeZen. Jarang perlu diubah.
OPencodeZen_BASE_URL=https://opencode.ai/zen/v1

# Nama model LLM yang dipakai untuk jawaban bebas.
OPencodeZen_MODEL=deepseek-v4-flash-free
